# Used when invoking Docker Compose directly. The helper scripts set these
# values automatically, so copying this file is optional.
TARGET_REPO=/absolute/path/to/python-repository
OUTPUT_DIR=/absolute/path/to/empty/output-directory
REPOSITORY_ID=my-python-repository
TRIAGE_PROVIDER=fake

# Required only when TRIAGE_PROVIDER=real.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
